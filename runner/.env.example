# Copy to runner/.env and fill in real values. runner/.env is gitignored and
# MUST NEVER be committed — keys never enter the repo.
#
# WCB_API_BASE points at an OpenAI-compatible endpoint. For reproducible public
# data, use each vendor's official API base URL + official key; a shared
# OpenAI-compatible gateway is fine for local development only.

WCB_GPT_KEY=
WCB_GROK_KEY=
WCB_API_BASE=http://localhost:8080/v1
